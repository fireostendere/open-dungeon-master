# qwen3.8-dm: DM alias for Open Dungeon Master on this machine.
# Built on the already-installed qwen3.8:27b (Q4_K_M, tool-capable) so no
# new weights are downloaded. Bakes a large context and Qwen's recommended
# non-thinking samplers, following models/qwen3.6-dm.Modelfile upstream.
#
# Build with:
#   ollama create qwen3.8-dm -f models/qwen3.8-dm.Modelfile

FROM qwen3.8:27b

PARAMETER num_ctx 32768

PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER min_p 0.0
