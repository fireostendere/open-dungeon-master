{
    auto_https disable_redirects
}

api.iroslyakov.com, dnd.iroslyakov.com {
    handle /rtc* {
        reverse_proxy localhost:7880
    }
    handle /twirp/* {
        reverse_proxy localhost:7880
    }
    handle /livekit/webhook {
        reverse_proxy localhost:8765
    }

    # ODM is served on both names; dnd.iroslyakov.com is canonical. The legacy
    # LiveKit web app stays on :8443.
    # Reloading this file is graceful and does not stop either application.
    @odm_mcp path /mcp /mcp/*
    handle @odm_mcp {
        reverse_proxy 127.0.0.1:3006
    }

    @odm_internal path /api/internal /api/internal/*
    handle @odm_internal {
        respond 404
    }

    @odm_narrator path /api/narrator
    handle @odm_narrator {
        reverse_proxy 127.0.0.1:3005
    }

    handle {
        reverse_proxy 127.0.0.1:3005
    }
}

# Keep the existing LiveKit web app available while ODM owns the main host.
https://api.iroslyakov.com:8443 {
    handle /rtc* {
        reverse_proxy localhost:7880
    }
    handle /twirp/* {
        reverse_proxy localhost:7880
    }
    handle /livekit/webhook {
        reverse_proxy localhost:8765
    }

    handle {
        reverse_proxy localhost:3000
    }
}
